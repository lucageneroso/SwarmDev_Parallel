# Set your NLP provider's API key here.
# Emcie is the official NLP service for Parlant, optimized for its engine.
EMCIE_API_KEY=your_emcie_api_key_here

# Or use other providers by passing them into p.Server(nlp_service=p.NLPServices.openai) 
# and providing the respective keys:
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# ----------------------------------------
# SwarmDev LangGraph Orchestrator Settings
# ----------------------------------------
# Set the LLM model using LiteLLM syntax. 
# Defaults to "gpt-4o". For OpenRouter use "openrouter/model-name"
LLM_MODEL=openrouter/anthropic/claude-3-haiku
OPENROUTER_API_KEY=your_openrouter_api_key_here
