ticle.best_position = np.copy(particle.position)\n                if value < self.global_best_value:\n                    self.global_best_value = value\n", 'truncated': True, 'file_size': 2438, 'modified_ts': 1780236158.5819764, 'mode': 'line_range'}, 'tool_name': 'read_file_segment', 'success': True, 'result_size': 2072, 'arguments': {'path': 'pso.py', 'start_line': 1, 'line_count': 40}, 'stage': 'after'} Duration: 0.003016233444213867
