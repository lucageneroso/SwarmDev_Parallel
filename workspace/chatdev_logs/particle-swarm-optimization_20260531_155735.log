s = [-10, 10]\\r\\n    num_particles = 30\\r\\n    iterations = 100\\r\\n\\r\\n    pso = PSO(num_particles, len(bounds), bounds, iterations)\\r\\n    pso.optimize(objective_function)\\r\\n\\r\\n    print(f\\"Global Best Position: {pso.global_best_position}\\")\\r\\n    print(f\\"Global Best Value: {pso.global_best_value}\\")\\r\\n",\n  "truncated": false,\n  "file_size": 446,\n  "modified_ts": 1780236247.3741615,\n  "mode": "line_range"\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 47,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2295,\n  "modified_ts": 1780236268.019201\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 96,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2493,\n  "modified_ts": 1780236268.0440238\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 192,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2879,\n  "modified_ts": 1780236268.0596037\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 19,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 533,\n  "modified_ts": 1780236268.063212\n}', 'output': None, 'input_size': 10532, 'output_size': 0, 'stage': 'before'} 
