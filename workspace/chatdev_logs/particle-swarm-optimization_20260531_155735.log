\\\\SwarmDev_Parallel\\\\ChatDev\\\\WareHouse\\\\particle-swarm-optimization_20260531155739\\\\code_workspace\\\\main.py",\n      "type": "file",\n      "size": 416,\n      "modified_ts": 1780235891.4784842,\n      "depth": 0\n    },\n    {\n      "name": "pso.py",\n      "relative_path": "pso.py",\n      "absolute_path": "C:\\\\Users\\\\lucag\\\\SwarmDev_Parallel\\\\ChatDev\\\\WareHouse\\\\particle-swarm-optimization_20260531155739\\\\code_workspace\\\\pso.py",\n      "type": "file",\n      "size": 2266,\n      "modified_ts": 1780235994.2153425,\n      "depth": 0\n    },\n    {\n      "name": "utils.py",\n      "relative_path": "utils.py",\n      "absolute_path": "C:\\\\Users\\\\lucag\\\\SwarmDev_Parallel\\\\ChatDev\\\\WareHouse\\\\particle-swarm-optimization_20260531155739\\\\code_workspace\\\\utils.py",\n      "type": "file",\n      "size": 373,\n      "modified_ts": 1780235941.2382276,\n      "depth": 0\n    }\n  ],\n  "truncated": false,\n  "recursive": true\n}{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 32,\n  "line_count": 40,\n  "lines_returned": 32,\n  "total_lines": 32,\n  "snippet": "\\"\\"\\"\\r\\r\\nUtility functions for the PSO algorithm.\\r\\r\\n\\"\\"\\"\\r\\r\\ndef objective_function(x):\\r\\r\\n    \\"\\"\\"\\r\\r\\n    Sample objective function: f(x) = x^2\\r\\r\\n    This function is to be minimized.\\r\\r\\n    \\"\\"\\"\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\ndef objective_function(x):\\r\\r\\n    \\"\\"\\"\\r\\r\\n    Sample objective function: f(x) = x^2\\r\\r\\n    This function is to be minimized.\\r\\r\\n    \\"\\"\\"\\r\\r\\n    return sum([xi ** 2 for xi in x])\\r\\r\\n",\n  "truncated": false,\n  "file_size": 373,\n  "modified_ts": 1780235941.2382276,\n  "mode": "line_range"\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 60,\n  "snippet": "class PSO:\\n    \\"\\"\\"\\n    Represents the Particle Swarm Optimization algorithm.\\n    \\"\\"\\"\\n\\n    def __init__(self, num_particles, bounds):\\n        \\"\\"\\"\\n        Initialize the PSO with a number of particles and bounds.\\n\\n        :param num_particles: Number of particles in the swarm.\\n        :param bounds: The bounds for the search space.\\n        \\"\\"\\"\\n        self.num_particles = num_particles\\n        self.bounds = bounds\\n        self.particles = [Particle(bounds) for _ in range(num_particles)]\\n        self.global_best_position = None\\n        self.global_best_value = float(\'inf\')\\n\\n    def evaluate(self, objective_function):\\n        \\"\\"\\"\\n        Evaluate the particles\' current positions using the objective function.\\n\\n        :param objective_function: The objective function to minimize.\\n        \\"\\"\\"\\n        for particle in self.particles:\\n            particle_value = objective_function(particle.position)\\n            if particle_value < particle.best_value:\\n                particle.best_value = particle_value\\n                particle.best_position = particle.position\\n                if particle_value < self.global_best_value:\\n                    self.global_best_value = particle_value\\n                    self.global_best_position = particle.position\\n\\n    def update_position(self):\\n        \\"\\"\\"\\n        Update the particles\' positions based on their velocities and keep them within bounds.\\n        \\"\\"\\"\\n        for particle in self.particles:\\n            particle.update_position(self.bounds)\\n\\n",\n  "truncated": true,\n  "file_size": 2266,\n  "modified_ts": 1780235994.2153425,\n  "mode": "line_range"\n}{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 21,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 233,\n  "modified_ts": 1780236015.470786\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "new