andom.uniform(-1, 1) for _ in range(len(bounds))]\\n        self.best_value = float(\'inf\')\\n\\n    def update_velocity(self, global_best_position):\\n        inertia = 0.5\\n        cognitive = 1.5 * random.random()\\n        social = 1.5 * random.random()\\n\\n        for i in range(len(self.velocity)):\\n            self.velocity[i] = (inertia * self.velocity[i] + \\n                                cognitive * (self.best_value - self.position[i]) + \\n                                social * (global_best_position[i] - self.position[i]))\\n\\n    def update_position(self, bounds):\\n        for i in range(len(self.position)):\\n            self.position[i] += self.velocity[i]\\n            self.position[i] = max(bounds[0], min(bounds[1], self.position[i]))\\n\\n    def evaluate(self, objective_function):\\n        value = objective_function(self.position)\\n        if value < self.best_value:\\n            self.best_value = value\\n\\nclass PSO:\\n    def __init__(self, num_particles, bounds):\\n        self.particles = [Particle(bounds) for _ in range(num_particles)]\\n        self.global_best_position = None\\n        self.global_best_value = float(\'inf\')\\n\\n    def optimize(self, objective_function, iterations):\\n        for _ in range(iterations):\\n            for particle in self.particles:\\n                particle.update_velocity(self.global_best_position)\\n                particle.update_position(bounds)\\n                particle.evaluate(objective_function)\\n",\n  "truncated": true,\n  "file_size": 1879,\n  "modified_ts": 1780235909.794089,\n  "mode": "line_range"\n}{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 10,\n  "line_count": 40,\n  "lines_returned": 10,\n  "total_lines": 10,\n  "snippet": "\\"\\"\\"\\nThis module contains utility functions for the PSO algorithm.\\n\\"\\"\\"\\n\\ndef objective_function(x):\\n    \\"\\"\\"\\n    Sample objective function: f(x) = x^2\\n    This function is to be minimized.\\n    \\"\\"\\"\\n    return sum([xi ** 2 for xi in x])\\n",\n  "truncated": false,\n  "file_size": 232,\n  "modified_ts": 1780235912.5269263,\n  "mode": "line_range"\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 46,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 1959,\n  "modified_ts": 1780235940.915372\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 46,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2083,\n  "modified_ts": 1780235940.9373415\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 94,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2268,\n  "modified_ts": 1780235940.9536724\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 188,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2563,\n  "modified_ts": 1780235940.9683962\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 379,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 3198,\n  "modified_ts": 1780235940.983554\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 761,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 4450,\n  "modified_ts": 1780235940.9999955\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 1525,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 6884,\n  "modified_ts": 1780235941.0366812\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 3053,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 11615,\n  "modified_ts": 1780235941.0784893\n}{\n  "path": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 6110,\n  "applied_edits": 1,\n  "t