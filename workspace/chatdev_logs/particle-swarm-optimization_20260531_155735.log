": "pso.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 54,\n  "snippet": "import random\\nimport numpy as np\\n\\nclass Particle:\\n    def __init__(self, dimensions, bounds):\\n        self.position = np.random.uniform(bounds[0], bounds[1], dimensions)\\n        self.velocity = np.random.uniform(-1, 1, dimensions)\\n        self.best_position = np.copy(self.position)\\n        self.best_value = float(\'inf\')\\n\\n    def update_velocity(self, global_best_position, inertia=0.5, cognitive=1.5, social=1.5):\\n        r1, r2 = np.random.rand(2)\\n        cognitive_velocity = cognitive * r1 * (self.best_position - self.position)\\n        social_velocity = social * r2 * (global_best_position - self.position)\\n        self.velocity = inertia * self.velocity + cognitive_velocity + social_velocity\\n\\n    def update_position(self, bounds):\\n        self.position += self.velocity\\n        # Keep the particle within bounds\\n        self.position = np.clip(self.position, bounds[0], bounds[1])\\n\\nclass PSO:\\n    def __init__(self, num_particles, dimensions, bounds, max_iterations):\\n        self.num_particles = num_particles\\n        self.dimensions = dimensions\\n        self.bounds = bounds\\n        self.max_iterations = max_iterations\\n        self.particles = [Particle(dimensions, bounds) for _ in range(num_particles)]\\n        self.global_best_position = None\\n        self.global_best_value = float(\'inf\')\\n\\n    def optimize(self, objective_function):\\n        for _ in range(self.max_iterations):\\n            for particle in self.particles:\\n                value = objective_function(particle.position)\\n                if value < particle.best_value:\\n                    particle.best_value = value\\n                    particle.best_position = np.copy(particle.position)\\n                if value < self.global_best_value:\\n                    self.global_best_value = value\\n",\n  "truncated": true,\n  "file_size": 2438,\n  "modified_ts": 1780236158.5819764,\n  "mode": "line_range"\n}', 'tool_call_id': 'call_MjEB7NyhWvKTlHNGLfBQlWeP', 'metadata': {'tool_name': 'read_file_segment', 'source': 'Programmer Code Review'}}, {'role': 'tool', 'content': '{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 42,\n  "snippet": "\\"\\"\\"\\r\\r\\n\\r\\r\\nUtility functions for the PSO algorithm.\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\ndef objective_function(x):\\r\\r\\n\\r\\r\\n    \\"\\"\\"\\r\\r\\n\\r\\r\\n    Sample objective function: f(x) = x^2\\r\\r\\n\\r\\r\\n    This function is to be minimized.\\r\\r\\n\\r\\r\\n    \\"\\"\\"\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 233,\n  "modified_ts": 1780236015.470786,\n  "mode": "line_range"\n}', 'tool_call_id': 'call_XIu191JBkIb1DpX1uwucfhz7', 'metadata': {'tool_name': 'read_file_segment', 'source': 'Programmer Code Review'}}, {'role': 'tool', 'content': '{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 17,\n  "line_count": 40,\n  "lines_returned": 17,\n  "total_lines": 17,\n  "snippet": "\\"\\"\\"\\nThis is the main module to launch the program.\\n\\"\\"\\"\\n\\nfrom pso import PSO\\nfrom utils import objective_function\\n\\nif __name__ == \\"__main__\\":\\n    bounds = [-10, 10]\\n    num_particles = 30\\n    iterations = 100\\n\\n    pso = PSO(num_particles, bounds)\\n    pso.optimize(objective_function, iterations)\\n\\n    print(f\\"Global Best Position: {pso.global_best_position}\\")\\n    print(f\\"Global Best Value: {pso.global_best_value}\\")\\n",\n  "truncated": false,\n  "file_size": 416,\n  "modified_ts": 1780235891.4784842,\n  "mode": "line_range"\n}', 'tool_call_id': 'call_leV7nl0xFixNqNiaKvKUhLUv', 'm