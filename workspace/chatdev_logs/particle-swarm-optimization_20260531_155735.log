\n                    particle.best_value = value\r\n                    particle.best_position = np.copy(particle.position)\r\n                    # Update global best position if current particle value is better than global best\r\n                if value < self.global_best_value:\r\n", 'truncated': True, 'file_size': 2221, 'modified_ts': 1780236244.8238988, 'mode': 'line_range'}, 'tool_name': 'read_file_segment', 'success': True, 'result_size': 2206, 'arguments': {'path': 'pso.py', 'start_line': 1, 'line_count': 40}, 'stage': 'after'} Duration: 0.004009723663330078
