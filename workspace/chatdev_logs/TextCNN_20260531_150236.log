ata_loader.load_data()\\r\\r\\n    \\r\\r\\n    # Initialize model\\r\\r\\n    vocab_size = len(tokenizer.vocab)\\r\\r\\n    embedding_dim = 100  # Choose appropriate embedding dimension\\r\\r\\n    num_classes = len(set(labels))  # Number of unique classes\\r\\r\\n    model = TextCNN(vocab_size, embedding_dim, num_classes)\\r\\r\\n",\n  "truncated": true,\n  "file_size": 14141,\n  "modified_ts": 1780232913.1939378,\n  "mode": "line_range"\n}{\n  "path": "textcnn.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 23,\n  "line_count": 40,\n  "lines_returned": 23,\n  "total_lines": 23,\n  "snippet": "import torch\\nimport torch.nn as nn\\nimport torch.nn.functional as F\\n\\nclass TextCNN(nn.Module):\\n    \\"\\"\\"This module defines the TextCNN architecture for text classification.\\"\\"\\"\\n\\n    def __init__(self, vocab_size, embedding_dim, num_classes):\\n        super(TextCNN, self).__init__()\\n        self.embedding = nn.Embedding(vocab_size, embedding_dim)\\n        self.conv1 = nn.Conv2d(1, 100, (3, embedding_dim))\\n        self.pool = nn.MaxPool2d((2, 1))\\n        self.fc = nn.Linear(100, num_classes)\\n\\n    def forward(self, x):\\n        \\"\\"\\"Forward pass for the TextCNN model.\\"\\"\\"\\n        x = self.embedding(x)\\n        x = x.unsqueeze(1)  # Add channel dimension\\n        x = self.conv1(x)\\n        x = F.relu(x)\\n        x = self.pool(x)\\n        x = x.view(x.size(0), -1)  # Flatten for the fully connected layer\\n        return self.fc(x)\\n",\n  "truncated": false,\n  "file_size": 823,\n  "modified_ts": 1780232882.625652,\n  "mode": "line_range"\n}{\n  "path": "trainer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 248,\n  "snippet": "\\"\\"\\"\\r\\r\\nThis module manages the training process for the TextCNN model.\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\nimport torch.optim as optim\\r\\r\