formance of the TextCNN model.\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n    def compute_accuracy(self):\\r\\r\\n        correct = 0\\r\\r\\n        total = 0\\r\\r\\n        with torch.no_grad():\\r\\r\\n            for texts, labels in self.data_loader:\\r\\r\\n                outputs = self.model(texts)\\r\\r\\n                _, predicted = torch.max(outputs.data, 1)\\r\\r\\n                total += labels.size(0)\\r\\r\\n                correct += (predicted == labels).sum().item()\\r\\r\\n        if total > 0:\\r\\r\\n            return correct / total\\r\\r\\n        else:\\r\\r\\n            return 0.0  # or handle it as you see fit\\r\\r\\n        self.model = model\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1503,\n  "modified_ts": 1780232700.334788,\n  "mode": "line_range"\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 480,\n  "snippet": "\\"\\"\\"\\r\\r\\n\\r\\r\\nThis is the main module to launch the program.\\r\\r\\nfrom dataloader import DataLoader\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nfrom textcnn import TextCNN\\r\\r\\n\\r\\r\\nfrom trainer import Trainer\\r\\r\\n\\r\\r\\nfrom dataloader import TextDataset\\r\\r\\n\\r\\r\\nfrom dataloader import DataLoader\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1960,\n  "modified_ts": 1780232721.501377,\n  "mode": "line_range"\n}{\n  "path": "textcnn.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 46,\n  "snippet": "\\"\\"\\"\\r\\r\\nThis module defines the TextCNN architecture for text classification.\\r\\r\\n\\"\\"\\"\\r\\r\\nimport torch\\r\\r\\nimport torch.nn as nn\\r\\r\\n\\r\\r\\n    def forward(self, x):\\r\\r\\n        x = self.embedding(x).unsqueeze(1)\\r\\r\\n        x1 = self.conv1(x).squeeze(3)\\r\\r\\n        x2 = self.conv2(x).squeeze(3)\\r\\r\\n        x3 = self.conv3(x).squeeze(3)\\r\\r\\n        x1 = nn.functional.relu(x1)\\r\\r\\n        x2 = nn.functional.relu(x2)\\r\\r\\n        x3 = nn.functional.relu(x3)\\r\\r\\n        x1 = nn.functional.max_pool1d(x1, x1.size(2)).view(x1.size(0), -1)\\r\\r\\n        x2 = nn.functional.max_pool1d(x2, x2.size(2)).view(x2.size(0), -1)\\r\\r\\n        x3 = nn.functional.max_pool1d(x3, x3.size(2)).view(x3.size(0), -1)\\r\\r\\n        x = torch.cat((x1, x2, x3), 1)\\r\\r\\n        x = self.dropout(x)\\r\\r\\n        return self.fc(x)\\r\\r\\n",\n  "truncated": true,\n  "file_size": 865,\n  "modified_ts": 1780232700.3405077,\n  "mode": "line_range"\n}{\n  "path": "trainer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 32,\n  "line_count": 40,\n  "lines_returned": 32,\n  "total_lines": 32,\n  "snippet": "\\"\\"\\"\\r\\nThis module manages the training process for the TextCNN model.\\r\\n\\"\\"\\"\\r\\nimport torch\\r\\nimport torch.optim as optim\\r\\nimport torch.nn.functional as F\\r\\n\\r\\nclass Trainer:\\r\\n    def __init__(self, model, train_loader, val_loader, num_epochs=10):\\r\\n        self.model = model\\r\\n        self.train_loader = train_loader\\r\\n        self.val_loader = val_loader\\r\\n        self.num_epochs = num_epochs\\r\\n        self.optimizer = optim.Adam(model.parameters())\\r\\n\\r\\n    def train(self):\\r\\n        for epoch in range(self.num_epochs):\\r\\n            self.model.train()\\r\\n            for texts, labels in self.train_loader:\\r\\n                self.optimizer.zero_grad()\\r\\n                outputs = self.model(texts)\\r\\n                loss = F.cross_entropy(outputs, labels)\\r\\n                loss.backward()\\r\\n                self.optimizer.step()\\r\\n\\r\\n    def evaluate(self):\\r\\n        self.model.eval()\\r\\n        correct = 0\\r\\n        total = 0\\r\\n        with torch.no_grad():\\r\\n       