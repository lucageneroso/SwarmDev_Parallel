\n    def forward(self, x):\\r\\n        x = self.embedding(x).unsqueeze(1)\\r\\n        x1 = self.conv1(x).squeeze(3)\\r\\n        x2 = self.conv2(x).squeeze(3)\\r\\n        x3 = self.conv3(x).squeeze(3)\\r\\n        x1 = nn.functional.relu(x1)\\r\\n        x2 = nn.functional.relu(x2)\\r\\n        x3 = nn.functional.relu(x3)\\r\\n        x1 = nn.functional.max_pool1d(x1, x1.size(2)).view(x1.size(0), -1)\\r\\n        x2 = nn.functional.max_pool1d(x2, x2.size(2)).view(x2.size(0), -1)\\r\\n        x3 = nn.functional.max_pool1d(x3, x3.size(2)).view(x3.size(0), -1)\\r\\n        x = torch.cat((x1, x2, x3), 1)\\r\\n        x = self.dropout(x)\\r\\n        return self.fc(x)\\r\\n        x = self.embedding(x).unsqueeze(1)\\r\\n        x1 = self.conv1(x).squeeze(3)\\r\\n        x2 = self.conv2(x).squeeze(3)\\r\\n        x3 = self.conv3(x).squeeze(3)\\r\\n        x1 = nn.functional.relu(x1)\\r\\n        x2 = nn.functional.relu(x2)\\r\\n        x3 = nn.functional.relu(x3)\\r\\n        x1 = nn.functional.max_pool1d(x1, x1.size(2)).view(x1.size(0), -1)\\r\\n        x2 = nn.functional.max_pool1d(x2, x2.size(2)).view(x2.size(0), -1)\\r\\n        x3 = nn.functional.max_pool1d(x3, x3.size(2)).view(x3.size(0), -1)\\r\\n",\n  "truncated": true,\n  "file_size": 1808,\n  "modified_ts": 1780232626.6055553,\n  "mode": "line_range"\n}{\n  "path": "trainer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 44,\n  "snippet": "\\"\\"\\"\\r\\nThis module manages the training process for the TextCNN model.\\r\\n\\"\\"\\"\\r\\nimport torch\\r\\nimport torch.optim as optim\\r\\nimport torch.nn.functional as F\\r\\n\\r\\nclass Trainer:\\r\\n    def __init__(self, model, train_loader, val_loader, num_epochs=10):\\r\\n        self.model = model\\r\\n        self.train_loader = train_loader\\r\\n        self.val_loader = val_loader\\r\\n        self.num_epochs = num_epochs\\r\\n        self.optimizer = optim.Adam(model.parameters())\\r\\n\\r\\n    def train(self):\\r\\n        for epoch in range(self.num_epochs):\\r\\n            self.model.train()\\r\\n            for texts, labels in self.train_loader:\\r\\n                self.optimizer.zero_grad()\\r\\n                outputs = self.model(texts)\\r\\n                loss = F.cross_entropy(outputs, labels)\\r\\n                loss.backward()\\r\\n                self.optimizer.step()\\r\\n        for epoch in range(self.num_epochs):\\r\\n            self.model.train()\\r\\n            for texts, labels in self.train_loader:\\r\\n                self.optimizer.zero_grad()\\r\\n                outputs = self.model(texts)\\r\\n                loss = F.cross_entropy(outputs, labels)\\r\\n                loss.backward()\\r\\n                self.optimizer.step()\\r\\n\\r\\n    def evaluate(self):\\r\\n        self.model.eval()\\r\\n        correct = 0\\r\\n        total = 0\\r\\n        with torch.no_grad():\\r\\n            for texts, labels in self.val_loader:\\r\\n                outputs = self.model(texts)\\r\\n",\n  "truncated": true,\n  "file_size": 1584,\n  "modified_ts": 1780232626.6096258,\n  "mode": "line_range"\n}{\n  "path": "dataloader.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 39,\n  "applied_edits": 1,\n  "trailing_newline": false,\n  "file_size": 1389,\n  "modified_ts": 1780232652.207194\n}{\n  "path": "dataloader.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 77,\n  "applied_edits": 1,\n  "trailing_newline": false,\n  "file_size": 1547,\n  "modified_ts": 1780232652.2318354\n}{\n  "path": "evaluator.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 27,\n  "applied_edits": 1,\n  "trailing_newline": false,\n  "file_size": 990,\n  "modified_ts": 1780232652.2356913\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 27,\n  "applied_edits": 1,\n  "trailing_newline": false,\n