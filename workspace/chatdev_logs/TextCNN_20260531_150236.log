1 = nn.Conv2d(1, 100, (3, embedding_dim))\\r\\n        self.pool = nn.MaxPool2d((2, 1))\\r\\n        self.fc = nn.Linear(100, num_classes)\\r\\n\\r\\n    def forward(self, x):\\r\\n        \\"\\"\\"Forward pass for the TextCNN model.\\"\\"\\"\\r\\n        x = self.embedding(x)\\r\\n        x = x.unsqueeze(1)  # Add channel dimension\\r\\n        x = self.conv1(x)\\r\\n        x = F.relu(x)\\r\\n        x = self.pool(x)\\r\\n        x = x.view(x.size(0), -1)  # Flatten for the fully connected layer\\r\\n        return self.fc(x)\\r\\n        x = x.view(x.size(0), -1)\\r\\n\\r\\n        x = self.fc(x)\\r\\n\\r\\n        return x\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n    def forward(self, x):\\r\\n",\n  "truncated": true,\n  "file_size": 3572,\n  "modified_ts": 1780232855.8217134,\n  "mode": "line_range"\n}', 'output': '', 'input_size': 10071, 'output_size': 0, 'has_tool_calls': True, 'stage': 'after'} 
