.file_path = file_path\\r\\n\\r\\n    def load_data(self):\\r\\n        data = pd.read_csv(self.file_path)\\r\\n        label_encoder = LabelEncoder()\\r\\n        data[\'label\'] = label_encoder.fit_transform(data[\'label\'])\\r\\n        texts = data[\'text\'].tolist()\\r\\n        labels = data[\'label\'].tolist()\\r\\n        return train_test_split(texts, labels, test_size=0.2, random_state=42)",\n  "truncated": false,\n  "file_size": 1315,\n  "modified_ts": 1780232626.596658,\n  "mode": "line_range"\n}{\n  "path": "evaluator.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 27,\n  "line_count": 40,\n  "lines_returned": 27,\n  "total_lines": 27,\n  "snippet": "\\"\\"\\"\\r\\nThis module evaluates the performance of the TextCNN model.\\r\\n\\"\\"\\"\\r\\nclass Evaluator:\\r\\n    def __init__(self, model, data_loader):\\r\\n        self.model = model\\r\\n        self.data_loader = data_loader\\r\\n\\r\\n    def compute_accuracy(self):\\r\\n        correct = 0\\r\\n        total = 0\\r\\n        with torch.no_grad():\\r\\n            for texts, labels in self.data_loader:\\r\\n                outputs = self.model(texts)\\r\\n                _, predicted = torch.max(outputs.data, 1)\\r\\n                total += labels.size(0)\\r\\n                correct += (predicted == labels).sum().item()\\r\\n        return correct / total\\r\\n        correct = 0\\r\\n        total = 0\\r\\n        with torch.no_grad():\\r\\n            for texts, labels in self.data_loader:\\r\\n                outputs = self.model(texts)\\r\\n                _, predicted = torch.max(outputs.data, 1)\\r\\n                total += labels.size(0)\\r\\n                correct += (predicted == labels).sum().item()\\r\\n        return correct / total",\n  "truncated": false,\n  "file_size": 964,\n  "modified_ts": 1780232626.6016455,\n  "mode": "line_range"\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  