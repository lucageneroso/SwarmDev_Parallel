1 = nn.Conv2d(1, 100, (3, embedding_dim))\\r\\n        self.pool = nn.MaxPool2d((2, 1))\\r\\n        self.fc = nn.Linear(100, num_classes)\\r\\n\\r\\n    def forward(self, x):\\r\\n        \\"\\"\\"Forward pass for the TextCNN model.\\"\\"\\"\\r\\n        x = self.embedding(x)\\r\\n        x = x.unsqueeze(1)  # Add channel dimension\\r\\n        x = self.conv1(x)\\r\\n        x = F.relu(x)\\r\\n        x = self.pool(x)\\r\\n        x = x.view(x.size(0), -1)  # Flatten for the fully connected layer\\r\\n        return self.fc(x)\\r\\n        x = x.view(x.size(0), -1)\\r\\n\\r\\n        x = self.fc(x)\\r\\n\\r\\n        return x\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n\\r\\n    def forward(self, x):\\r\\n",\n  "truncated": true,\n  "file_size": 3572,\n  "modified_ts": 1780232855.8217134,\n  "mode": "line_range"\n}{\n  "path": "evaluator.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 968,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 5159,\n  "modified_ts": 1780232882.6104176\n}{\n  "path": "textcnn.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 801,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 4323,\n  "modified_ts": 1780232882.6164165\n}{\n  "path": "evaluator.py",\n  "absolute_path": "C:\\\\Users\\\\lucag\\\\SwarmDev_Parallel\\\\ChatDev\\\\WareHouse\\\\TextCNN_20260531150239\\\\code_workspace\\\\evaluator.py",\n  "size": 555\n}{\n  "path": "textcnn.py",\n  "absolute_path": "C:\\\\Users\\\\lucag\\\\SwarmDev_Parallel\\\\ChatDev\\\\WareHouse\\\\TextCNN_20260531150239\\\\code_workspace\\\\textcnn.py",\n  "size": 823\n}', 'output': None, 'input_size': 10825, 'output_size': 0, 'stage': 'before'} 
