ing_dim))\\r\\n        self.fc = nn.Linear(300, num_classes)\\r\\n        self.dropout = nn.Dropout(0.5)\\r\\n\\r\\n    def forward(self, x):\\r\\n        x = self.embedding(x).unsqueeze(1)\\r\\n        x1 = self.conv1(x).squeeze(3)\\r\\n        x2 = self.conv2(x).squeeze(3)\\r\\n        x3 = self.conv3(x).squeeze(3)\\r\\n        x1 = nn.functional.relu(x1)\\r\\n        x2 = nn.functional.relu(x2)\\r\\n        x3 = nn.functional.relu(x3)\\r\\n        x1 = nn.functional.max_pool1d(x1, x1.size(2)).view(x1.size(0), -1)\\r\\n        x2 = nn.functional.max_pool1d(x2, x2.size(2)).view(x2.size(0), -1)\\r\\n        x3 = nn.functional.max_pool1d(x3, x3.size(2)).view(x3.size(0), -1)\\r\\n        x = torch.cat((x1, x2, x3), 1)\\r\\n        x = self.dropout(x)\\r\\n        return self.fc(x)\\r\\n        x = self.embedding(x).unsqueeze(1)\\r\\n        x1 = self.conv1(x).squeeze(3)\\r\\n        x2 = self.conv2(x).squeeze(3)\\r\\n        x3 = self.conv3(x).squeeze(3)\\r\\n        x1 = nn.functional.relu(x1)\\r\\n        x2 = nn.functional.relu(x2)\\r\\n        x3 = nn.functional.relu(x3)\\r\\n        x1 = nn.functional.max_pool1d(x1, x1.size(2)).view(x1.size(0), -1)\\r\\n        x2 = nn.functional.max_pool1d(x2, x2.size(2)).view(x2.size(0), -1)\\r\\n        x3 = nn.functional.max_pool1d(x3, x3.size(2)).view(x3.size(0), -1)\\r\\n",\n  "truncated": true,\n  "file_size": 1808,\n  "modified_ts": 1780232626.6055553,\n  "mode": "line_range"\n}{\n  "path": "trainer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 44,\n  "snippet": "\\"\\"\\"\\r\\nThis module manages the training process for the TextCNN model.\\r\\n\\"\\"\\"\\r\\nimport torch\\r\\nimport torch.optim as optim\\r\\nimport torch.nn.functional as F\\r\\n\\r\\nclass Trainer:\\r\\n    def __init__(self, model, train_loader, val_loader, num_epochs=10):\\r\\n        self.model = model\\r\\n        self.train_loader = tra