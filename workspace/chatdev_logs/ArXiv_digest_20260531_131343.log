es else []\r\n35:        with open(filename, \'w\', newline=\'\', encoding=\'utf-8\') as output_file:\r\n36:            dict_writer = csv.DictWriter(output_file, fieldnames=keys)\r\n37:            dict_writer.writeheader()\r\n38:            dict_writer.writerows(entries)\r\n39:\r\n40:    def print_results(self, entries):\r\n41:        for entry in entries:\r\n42:            print(entry)\r\n43:\r\n44:    def search_and_output(self, search_query, start=0, max_results=10, to_csv=False, filename="output.csv"):\r\n45:        raw_data = self.query_arxiv(search_query, start, max_results)\r\n46:        entries = self.parse_results(raw_data)\r\n47:        if to_csv:\r\n48:            self.save_to_csv(entries, filename)\r\n49:        else:\r\n50:            self.print_results(entries)\r\n51:\r\n52:# Example Usage\r\n53:if __name__ == "__main__":\r\n54:    tool = ArxivQueryTool()\r\n55:    tool.search_and_output("machine learning", to_csv=True, filename="ml_research.csv")\r\n', 'truncated': False, 'file_size': 2332, 'modified_ts': 1780226071.9156063, 'mode': 'line_range'}, 'tool_name': 'read_file_segment', 'success': True, 'result_size': 2916, 'arguments': {'path': 'arxiv_query_tool/arxiv_query_tool.py', 'start_line': 1, 'line_count': 60, 'inline_line_numbers': True, 'encoding': 'auto', 'include_line_offsets': False}, 'stage': 'after'} Duration: 0.039618730545043945
