f, indicators):",\n      "before": [\n        "        plt.show()",\n        ""\n      ],\n      "after": [\n        "        \\"\\"\\"",\n        "        Plots the calculated indicators on the financial data."\n      ]\n    }\n  ],\n  "limited": false,\n  "engine": "python",\n  "searched_files": 4\n}{\n  "path": "data_loader.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 7,\n  "end_line": 26,\n  "line_count": 20,\n  "lines_returned": 20,\n  "total_lines": 32,\n  "snippet": "class DataLoader:\\n    def load_csv(self, file_path):\\n        \\"\\"\\"\\n        Loads financial data from a CSV file.\\n\\n        Parameters:\\n        file_path (str): Path to the CSV file.\\n\\n        Returns:\\n        pd.DataFrame: Loaded financial data.\\n        \\"\\"\\"\\n        return pd.read_csv(file_path)\\n\\n    def load_api(self, endpoint):\\n        \\"\\"\\"\\n        Loads financial data from a given API endpoint.\\n\\n        Parameters:\\n        endpoint (str): The API endpoint to fetch data from.\\n\\n",\n  "truncated": true,\n  "file_size": 775,\n  "modified_ts": 1780236872.982099,\n  "mode": "line_range"\n}{\n  "path": "financial_analyzer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 7,\n  "end_line": 54,\n  "line_count": 50,\n  "lines_returned": 48,\n  "total_lines": 54,\n  "snippet": "class FinancialAnalyzer:\\n    def __init__(self, data):\\n        \\"\\"\\"\\n        Initializes the FinancialAnalyzer with financial data.\\n\\n        Parameters:\\n        data (pd.DataFrame): Financial data in a DataFrame format.\\n        \\"\\"\\"\\n        self.data = data\\n\\n    def calculate_moving_average(self, window):\\n        \\"\\"\\"\\n        Calculates the moving average over a specified window.\\n\\n        Parameters:\\n        window (int): The window size for the moving average.\\n\\n        Returns:\\n        pd.Series: The moving average of the data.\\n        \\"\\"\\"\\n        return self.data[\'close\'].rolling(window=window).mean()\\n\\n    def calculate_rsi(self, period):\\n        \\"\\"\\"\\n        Calculates the Relative Strength Index (RSI).\\n\\n        Parameters:\\n        period (int): The period to calculate RSI.\\n\\n        Returns:\\n        pd.Series: The RSI values.\\n        \\"\\"\\"\\n        delta = self.data[\'close\'].diff()\\n        gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()\\n        loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()\\n        rs = gain / loss\\n        return 100 - (100 / (1 + rs))\\n\\n    def calculate_macd(self):\\n        \\"\\"\\"\\n        Calculates the Moving Average Convergence Divergence (MACD).\\n\\n        Returns:\\n        pd.Series: The MACD values.\\n        \\"\\"\\"\\n        short_ema = self.data[\'close\'].ewm(span=12, adjust=False).mean()\\n        long_ema = self.data[\'close\'].ewm(span=26, adjust=False).mean()\\n        return short_ema - long_ema\\n",\n  "truncated": false,\n  "file_size": 1553,\n  "modified_ts": 1780236872.9732974,\n  "mode": "line_range"\n}{\n  "path": "visualization.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 7,\n  "end_line": 36,\n  "line_count": 30,\n  "lines_returned": 30,\n  "total_lines": 37,\n  "snippet": "class Visualization:\\n    def plot_data(self, data):\\n        \\"\\"\\"\\n        Plots the financial data.\\n\\n        Parameters:\\n        data (pd.DataFrame): Financial data to plot.\\n        \\"\\"\\"\\n        plt.figure(figsize=(10, 5))\\n        plt.plot(data[\'date\'], data[\'close\'], label=\'Close Price\')\\n        plt.title(\'Financial Data\')\\n        plt.xlabel(\'Date\')\\n        plt.ylabel(\'Price\')\\n        plt.legend()\\n        plt.show()\\n\\n    def plot_indicators(self, indicators):\\n        \\"\\"\\"\\n        Plots the calculated indicators on the financial data.\\n\\n        Parameters:\\n        indicators (dict): Dictionary containing indicator names and their values.\\n        \\"\\"\\"\\n        plt.figure(figsize=(10, 5))\\n        for name, values in indicators.items():\\n            plt.plot(values, label=name)\\n        plt.title(\'Indicators\')\\n        plt.xlabel(\'Date\')\\n        plt.ylabel(\'Value\')\\n        plt.legend()\\n",\n  "truncated": true,\n  "file_size": 1028,\n  "modified_ts": 1780236872.985463,\n  "mode": "line_range"\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 20,\n  "line_count": 20,\n  "lines_returned": 20,\n  "total_lines": 22,\n  "snippet": "\\"\\"\\"\\nThis is the main module to launch the program.\\n\\"\\"\\"\\nfrom data_loader import DataLoader\\nfrom financial_analyzer import FinancialAnalyzer\\nfrom visualization import Visualization\\n\\ndef run():\\n    data_loader = DataLoader()\\n    data = data_loader.load_csv(\'financial_data.csv\')  # Replace with actual file path\\n\\n    analyzer = FinancialAnalyzer(data)\\n    moving_average = analyzer.calculate_moving_average(window=20)\\n    rsi = analyzer.calculate_rsi(period=14)\\n    macd = analyzer.calculate_macd()\\n\\n    visualization = Visualization()\\n    visualization.plot_data(data)\\n    visualization.plot_indicators({\'Moving Average\': moving_average, \'RSI\': rsi, \'MACD\': macd})\\n\\n",\n  "truncated": true,\n  "file_size": 701,\n  "modified_ts": 1780236872.9884722,\n  "mode": "line_range"\n}{\n  "path": "data_loader.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 40,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 984,\n  "modified_ts": 1780236890.5259745\n}{\n  "path": "data_loader.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 48,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 1254,\n  "modified_ts": 1780236890.5519197\n}{\n  "path": "financial_analyzer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 59,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 1760,\n  "modified_ts": 1780236890.5559213\n}{\n  "path": "financial_analyzer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 67,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2054,\n  "modified_ts": 1780236890.5718975\n}{\n  "path": "financial_analyzer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 142,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2411,\n  "modified_ts": 1780236890.5906985\n}{\n  "path": "financial_analyzer.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 289,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 2927,\n  "modified_ts": 1780236890.6084838\n}{\n  "path": "visualization.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 42,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 1174,\n  "modified_ts": 1780236890.611513\n}{\n  "path": "visualization.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "line_count": 47,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 1390,\n  "modified_ts": 1780236890.6448495\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "line_count": 23,\n  "applied_edits": 1,\n  "trailing_newline": true,\n  "file_size": 834,\n  "modified_ts": 1780236890.6498647\n}', 'output': None, 'input_size': 14454, 'output_size': 0, 'stage': 'before'} 
