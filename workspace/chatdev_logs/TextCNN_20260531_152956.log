nel_size=(49, 1))\\r\\r\\n        self.fc1 = nn.Linear(100 * 49, num_classes)  # Adjust according to input size\\r\\r\\n    \\r\\r\\n    def forward(self, x):\\r\\r\\n        x = self.embedding(x)\\r\\r\\n        x = x.unsqueeze(1)\\r\\r\\n        x = self.conv1(x)\\r\\r\\n        x = self.pool(x)\\r\\r\\n        x = x.view(-1, 100 * 49)\\r\\r\\n",\n  "truncated": true,\n  "file_size": 2807,\n  "modified_ts": 1780234409.0030675,\n  "mode": "line_range"\n}{\n  "path": "train.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 374,\n  "snippet": "\\"\\"\\"\\r\\r\\nModule containing functions for training the model.\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\ndef train_model(model, train_loader, criterion, optimizer, num_epochs=5):\\r\\r\\n    \\"\\"\\"Train the TextCNN model.\\"\\"\\"\\r\\r\\n    model.train()\\r\\r\\n    for epoch in range(num_epochs):\\r\\r\\n        for inputs, labels in train_loader:  # Iterate over batches\\r\\r\\n            optimizer.zero_grad()\\r\\r\\n            outputs = model(inputs)\\r\\r\\n            loss = criterion(outputs, labels)\\r\\r\\n            loss.backward()\\r\\r\\n            optimizer.step()\\r\\r\\n            print(f\'Epoch [{epoch+1}/{num_epochs}], Loss: {loss.item():.4f}\')\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nfrom data_preprocessing import load_data, preprocess_data, split_data\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1819,\n  "modified_ts": 1780234409.0119634,\n  "mode": "line_range"\n}{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 34,\n  "line_count": 40,\n  "lines_returned": 34,\n  "total_lines": 34,\n  "snippet": "\\"\\"\\"\\r\\r\\nUtility functions for saving and loading models.\\r\\r\\n\\"\\"\\"\\r\\r\\nimport torch\\r\\r\\n\\r\\r\\ndef save_model(model, path=\'model.pth\'):\\r\\r\\n    \\"\\"\\"Save the model to the specified path.\\"\