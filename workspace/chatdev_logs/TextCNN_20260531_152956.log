\n    \\"\\"\\"Evaluate the TextCNN model.\\"\\"\\"\\\\n    model.eval()\\\\n    total, correct = 0, 0\\\\n    with torch.no_grad():\\\\n        for inputs, labels in test_loader:\\\\n            outputs = model(inputs)\\\\n            _, predicted = torch.max(outputs.data, 1)\\\\n            total += labels.size(0)\\\\n            correct += (predicted == labels).sum().item()\\\\n    accuracy = correct / total\\\\n    print(f\'Accuracy: {accuracy:.4f}\')\\r\\r\\n\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nimport torch\\r\\r\\n\\r\\r\\n    data = load_data(\'data.csv\')  # Load data once\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nfrom data_preprocessing import load_data, preprocess_data, split_data\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1719,\n  "modified_ts": 1780234346.6757557,\n  "mode": "line_range"\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 9,\n  "line_count": 40,\n  "lines_returned": 9,\n  "total_lines": 9,\n  "snippet": "\\"\\"\\"\\r\\nThis is the main module to launch the program\\r\\n\\"\\"\\"\\r\\nfrom train import train_model\\r\\n    model = TextCNN(embed_size=300, num_classes=2)  # Adjust embed_size and num_classes as needed\\r\\n\\r\\nif __name__ == \\"__main__\\":\\r\\n    train_model()\\r\\n    evaluate_model()\\r\\n",\n  "truncated": false,\n  "file_size": 261,\n  "modified_ts": 1780234346.6780083,\n  "mode": "line_range"\n}{\n  "path": "model.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 134,\n  "snippet": "\\"\\"\\"\\r\\r\\nModule defining the TextCNN model.\\r\\r\\n\\"\\"\\"\\r\\r\\nclass TextCNN(nn.Module):\\\\n    def __init__(self, embed_size=300, num_classes=2): # Set default values for embed_size and num_classes\\\\n        super(TextCNN, self).__init__()\\\\n        self.embedding = nn.EmbeddingBag(10000, embed_size, sparse=True)\\\\n        self.conv1 = nn.Conv2d(1, 100, (3, embed_size))\\\\n        self.pool = nn.MaxPool2d(kernel_size=(49, 1))\\\\n        self.fc1 = nn.Linear(100 * 49, num_classes)  # Adjust according to input size\\r\\r\\nimport torch.nn as nn\\r\\r\\n\\r\\r\\nclass TextCNN(nn.Module):\\r\\r\\n    def __init__(self, embed_size, num_classes):\\r\\r\\n        super(TextCNN, self).__init__()\\r\\r\\n        self.embedding = nn.EmbeddingBag(10000, embed_size, sparse=True)\\r\\r\\n        self.conv1 = nn.Conv2d(1, 100, (3, embed_size))\\r\\r\\n        self.pool = nn.MaxPool2d(kernel_size=(49, 1))\\r\\r\\n        self.fc1 = nn.Linear(100 * 49, num_classes)  # Adjust according to input size\\r\\r\\n\\r\\r\\n    def forward(self, x):\\r\\r\\n        x = self.embedding(x).view(-1, 1, 100, embed_size)\\r\\r\\n        x = self.pool(self.conv1(x))\\r\\r\\n        x = x.view(x.size(0), -1)\\r\\r\\n        x = self.fc1(x)\\r\\r\\n        return x\\r\\r\\n",\n  "truncated": true,\n  "file_size": 2106,\n  "modified_ts": 1780234346.6727543,\n  "mode": "line_range"\n}{\n  "path": "train.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 212,\n  "snippet": "\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nModule containing functions for training the model.\\r\\r\\ndef train_model(model, train_loader, criterion, optimizer, num_epochs=5):\\\\n    \\"\\"\\"Train the TextCNN model.\\"\\"\\"\\\\n    model.train()\\\\n    for epoch in range(num_epochs):\\\\n        for inputs, labels in train_loader:  # Iterate over batches\\\\n            optimizer.zero_grad()\\\\n            outputs = model(inputs)\\\\n            loss = criterion(outputs, labels)\\\\n            loss.backward()\\\\n            optimizer.step()\\\\n            print(f\'Epoch [{epoch+1}/{num_epochs}], Loss: {loss.item():.4f}\')\\r\\r\\n\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nimport torch\\r\\r\\n\\r\\r\