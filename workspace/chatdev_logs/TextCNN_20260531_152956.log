mode": "line_range"\n}{\n  "path": "evaluate.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 220,\n  "snippet": "\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nModule containing functions for evaluating the model.\\r\\r\\ndef evaluate_model(model, test_loader):\\\\n    \\"\\"\\"Evaluate the TextCNN model.\\"\\"\\"\\\\n    model.eval()\\\\n    total, correct = 0, 0\\\\n    with torch.no_grad():\\\\n        for inputs, labels in test_loader:\\\\n            outputs = model(inputs)\\\\n            _, predicted = torch.max(outputs.data, 1)\\\\n            total += labels.size(0)\\\\n            correct += (predicted == labels).sum().item()\\\\n    accuracy = correct / total\\\\n    print(f\'Accuracy: {accuracy:.4f}\')\\r\\r\\n\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nimport torch\\r\\r\\n\\r\\r\\n    data = load_data(\'data.csv\')  # Load data once\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nfrom data_preprocessing import load_data, preprocess_data, split_data\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1719,\n  "modified_ts": 1780234346.6757557,\n  "mode": "line_range"\n}', 'output': '', 'input_size': 12294, 'output_size': 0, 'has_tool_calls': True, 'stage': 'after'} 
