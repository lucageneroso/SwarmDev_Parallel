ard(self, x):\\r\\r\\n",\n  "truncated": true,\n  "file_size": 2479,\n  "modified_ts": 1780234373.2009883,\n  "mode": "line_range"\n}{\n  "path": "train.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 212,\n  "snippet": "\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nModule containing functions for training the model.\\r\\r\\ndef train_model(model, train_loader, criterion, optimizer, num_epochs=5):\\\\n    \\"\\"\\"Train the TextCNN model.\\"\\"\\"\\\\n    model.train()\\\\n    for epoch in range(num_epochs):\\\\n        for inputs, labels in train_loader:  # Iterate over batches\\\\n            optimizer.zero_grad()\\\\n            outputs = model(inputs)\\\\n            loss = criterion(outputs, labels)\\\\n            loss.backward()\\\\n            optimizer.step()\\\\n            print(f\'Epoch [{epoch+1}/{num_epochs}], Loss: {loss.item():.4f}\')\\r\\r\\n\\r\\r\\n\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nimport torch\\r\\r\\n\\r\\r\\n    data = load_data(\'data.csv\')  # Load data once\\r\\r\\n\\r\\r\\n\\r\\r\\n\\r\\r\\nfrom model import TextCNN\\r\\r\\n\\r\\r\\n",\n  "truncated": true,\n  "file_size": 1683,\n  "modified_ts": 1780234346.6692357,\n  "mode": "line_range"\n}{\n  "path": "utils.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 45,\n  "snippet": "\\"\\"\\"\\r\\nUtility functions for saving and loading models.\\r\\n\\"\\"\\"\\r\\nimport torch\\r\\n\\r\\n\\r\\ndef save_model(model, path=\'model.pth\'):\\r\\n    \\"\\"\\"Save the model to the specified path.\\"\\"\\"\\r\\n    torch.save(model.state_dict(), path)\\r\\n\\r\\n\\r\\ndef load_model(model, path=\'model.pth\'):\\r\\n    \\"\\"\\"Load the model from the specified path.\\"\\"\\"\\r\\n    model.load_state_dict(torch.load(path))\\r\\n\\r\\nUtility functions for saving 