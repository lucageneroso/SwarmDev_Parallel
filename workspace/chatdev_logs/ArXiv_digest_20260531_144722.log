y`:\n```python\n"""\nThis is the main module to launch the program.\n"""\n\nfrom arxiv_query_tool import ArXivQueryTool\nfrom csv_handler import CSVHandler  # Assuming you have a CSVHandler class\n\ndef run():\n    tool = ArXivQueryTool()\n    query = input("Enter your query: ")\n    results = tool.search(query)  # It assumes the search method is implemented\n\n    output_option = input("Do you want to save the results to CSV? (yes/no): ")\n    while output_option.lower() not in [\'yes\', \'no\']:\n        print("Please enter \'yes\' or \'no\'.")\n        output_option = input("Do you want to save the results to CSV? (yes/no): ")\n\n    if output_option.lower() == \'yes\':\n        filename = input("Please enter the filename (with .csv extension): ")\n        # Add error handling for filename\n        if not filename.endswith(\'.csv\'):\n            print("Error: Filename must end with .csv")\n            return\n        tool.save_to_csv(results, filename)\n        print(f"Results saved to {filename}.")\n    else:\n        tool.print_results(results)\n```\n\n#### Modifications for `csv_handler.py`:\n```python\n"""\nThis module handles CSV file operations for saving query results.\n"""\n\nimport os\nimport pandas as pd  # Ensure pandas is imported\n\nclass CSVHandler:\n    def save_to_csv(self, data, filename):\n        # Validate the filename\n        if not isinstance(filename, str) or not filename.endswith(\'.csv\'):\n            print(f"Error: \'{filename}\' is not a valid filename. It must end with .csv.")\n            return\n\n        # Validate the data\n        if not data or not isinstance(data, (list, dict)):\n            print("Error: No data provided or data is not in a valid format.")\n            return\n\n        if os.path.exists(filename):\n            overwrite = input(f"The file {filename} already exists. Do you want to overwrite it? (yes/no): ").lower()\n            if overwrite != \'yes\':\n                print("File not saved.")\n             