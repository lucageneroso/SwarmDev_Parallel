ers:\\n        query (str): The search query string.\\n\\n        Returns:\\n        dict: A dictionary containing the search results.\\n        \\"\\"\\"\\n        params = {\'search_query\': query, \'start\': 0, \'max_results\': 10}\\n        response = requests.get(self.base_url, params=params)\\n\\n        if response.status_code == 200:\\n            return response.json()\\n        else:\\n            raise Exception(\\"Error querying the ArXiv database.\\")\\n\\n    def save_to_csv(self, data: dict, filename: str):\\n        \\"\\"\\"\\n        Saves the query results to a specified CSV file.\\n\\n        Parameters:\\n        data (dict): The data to save.\\n        filename (str): The name of the file to save the data to.\\n        \\"\\"\\"\\n",\n  "truncated": true,\n  "file_size": 1523,\n  "modified_ts": 1780231674.7354913,\n  "mode": "line_range"\n}{\n  "path": "csv_handler.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 18,\n  "line_count": 20,\n  "lines_returned": 18,\n  "total_lines": 18,\n  "snippet": "import pandas as pd\\n\\nclass CSVHandler:\\n    \\"\\"\\"\\n    Handles CSV file operations.\\n    \\"\\"\\"\\n\\n    @staticmethod\\n    def write_to_csv(filename: str, data: list):\\n        \\"\\"\\"\\n        Writes a list of dictionaries to a CSV file.\\n\\n        Parameters:\\n        filename (str): The name of the file to write to.\\n        data (list): The data to write to the CSV.\\n        \\"\\"\\"\\n        df = pd.DataFrame(data)\\n        df.to_csv(filename, index=False)",\n  "truncated": false,\n  "file_size": 435,\n  "modified_ts": 1780231674.7420506,\n  "mode": "line_range"\n}{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\n",\n  "start_line": 1,\n  "end_line": 20,\n  "line_count": 20,\n  "lines_returned": 20,\n  "total_lines": 20,\n  "snippet": "\\"\\"\\"\\nThis is the main module to launch the program.\\n\\"\\"\\"\\nfrom arxiv_query_tool import ArXivQueryTool\\n\\ndef