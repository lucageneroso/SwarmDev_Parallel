e.raise_for_status()  # Raises an HTTPError for bad responses\n            return response.json()[\'entries\']  # Adapt as necessary for actual response structure\n        except requests.exceptions.RequestException as e:\n            print(f"Error querying ArXiv: {e}")\n            return []\n\n    def save_to_csv(self, results, filename):\n        """\n        Saves the query results to a CSV file.\n        \n        Parameters:\n        results (list): The list of results to save.\n        filename (str): The name of the file to save results into.\n        """\n        try:\n            with open(filename, mode=\'w\', newline=\'\') as file:\n                writer = csv.writer(file)\n                writer.writerow(["Title", "Authors", "Summary"])  # Header\n                for result in results:\n                    writer.writerow([result[\'title\'], \', \'.join(result[\'authors\']), result[\'summary\']])\n        except Exception as e:\n            print(f"Error saving to CSV: {e}")\n\n    def print_results(self, results):\n        """\n        Prints the query results to the console.\n        \n        Parameters:\n        results (list): The list of results to print.\n        """\n        for result in results:\n            print(f"Title: {result[\'title\']}")\n            print(f"Authors: {\', \'.join(result[\'authors\'])}")\n            print(f"Summary: {result[\'summary\']}\\n")\n```\n\n### Now, let\'s proceed to update `csv_handler.py` if necessary and then `main.py`.\n\n#### Modifications to `csv_handler.py`\nAssuming `csv_handler.py` is straightforward and mainly handles the CSV operations, ensure it has error handling similar to what\'s shown in the `save_to_csv` method.\n\n### Modifications to `main.py`\n\n```python\n"""\nThis is the main module to launch the program.\n"""\n\nfrom arxiv_query_tool import ArXivQueryTool\n\ndef run():\n    tool = ArXivQueryTool()\n    query = input("Enter your query: ")\n    results = tool.search(query)\n\n    if not r