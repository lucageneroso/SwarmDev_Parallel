ta successfully saved to {filename}.\\")\\n        except Exception as e:\\n            print(f\\"Error occurred while saving to CSV: {e}\\")\\n",\n  "truncated": false,\n  "file_size": 1130,\n  "modified_ts": 1780231923.3119287,\n  "mode": "line_range"\n}', 'tool_call_id': 'call_sLOLJ0qXoQAnNmHZ1b9aePpC', 'metadata': {'tool_name': 'read_file_segment', 'source': 'Code Reviewer'}}, {'role': 'tool', 'content': '{\n  "path": "main.py",\n  "encoding": "utf-8-sig",\n  "newline": "\\r\\n",\n  "start_line": 1,\n  "end_line": 40,\n  "line_count": 40,\n  "lines_returned": 40,\n  "total_lines": 118,\n  "snippet": "\\"\\"\\"\\r\\r\\nThis is the main module to launch the program.\\r\\r\\n\\"\\"\\"\\r\\r\\n\\r\\r\\nfrom arxiv_query_tool import ArXivQueryTool\\r\\r\\nfrom csv_handler import CSVHandler  # Assuming you have a CSVHandler class\\r\\r\\n\\r\\r\\ndef run():\\r\\r\\n    tool = ArXivQueryTool()\\r\\r\\n    query = input(\\"Enter your query: \\")\\r\\r\\n    results = tool.search(query)  # It assumes the search method is implemented\\r\\r\\n\\r\\r\\n    # Validate results before saving\\r\\r\\n    if results is None:\\r\\r\\n        print(\\"No results found for your query.\\")\\r\\r\\n        return\\r\\r\\n\\r\\r\\n    output_option = input(\\"Do you want to save the results to CSV? (yes/no): \\")\\r\\r\\n    while output_option.lower() not in [\'yes\', \'no\']:\\r\\r\\n        print(\\"Please enter \'yes\' or \'no\'.\\")\\r\\r\\n",\n  "truncated": true,\n  "file_size": 2404,\n  "modified_ts": 1780231964.9003792,\n  "mode": "line_range"\n}', 'tool_call_id': 'call_DpBsjPclDFMe3zPXvhW1NPo2', 'metadata': {'tool_name': 'read_file_segment', 'source': 'Code Reviewer'}}, {'role': 'assistant', 'content': [{'type': 'text', 'text': '### Review Summary:\n\n1. **Import Statements:** \n   - The necessary classes (`ArXivQueryTool` and `CSVHandler`) are imported correctly.\n\n2. **Method Implementations:** \n   - The `save_to_csv` method is implemented in the `CSVHandler` class. Howev