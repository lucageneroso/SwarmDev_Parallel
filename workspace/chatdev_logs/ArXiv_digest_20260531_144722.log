sponse.json()\n        else:\n            raise Exception("Error querying the ArXiv database.")\n\n    def save_to_csv(self, data: dict, filename: str):\n        """\n        Saves the query results to a specified CSV file.\n\n        Parameters:\n        data (dict): The data to save.\n        filename (str): The name of the file to save the data to.\n        """\n        df = pd.DataFrame(data)\n        df.to_csv(filename, index=False)\n\n    def print_results(self, data: dict):\n        """\n        Prints the query results to the console.\n\n        Parameters:\n        data (dict): The data to print.\n        """\n        for item in data:\n            print(f"Title: {item[\'title\']}")\n            print(f"Authors: {item[\'authors\']}")\n            print(f"Summary: {item[\'summary\']}\\n")\n```\n\n#### 2. `csv_handler.py`\n\n```python\nimport pandas as pd\n\nclass CSVHandler:\n    """\n    Handles CSV file operations.\n    """\n\n    @staticmethod\n    def write_to_csv(filename: str, data: list):\n        """\n        Writes a list of dictionaries to a CSV file.\n\n        Parameters:\n        filename (str): The name of the file to write to.\n        data (list): The data to write to the CSV.\n        """\n        df = pd.DataFrame(data)\n        df.to_csv(filename, index=False)\n```\n\n#### 3. `main.py`\n\n```python\n"""\nThis is the main module to launch the program.\n"""\nfrom arxiv_query_tool import ArXivQueryTool\n\ndef run():\n    tool = ArXivQueryTool()\n    query = input("Enter your query: ")\n    results = tool.search(query)\n    \n    output_option = input("Do you want to save the results to CSV? (yes/no): ")\n    if output_option.lower() == \'yes\':\n        filename = input("Enter the filename to save results (with .csv): ")\n        tool.save_to_csv(results, filename)\n        print(f"Results saved to {filename}.")\n    else:\n        tool.print_results(results)\n\nif __name__ == "__main__":\n    run()\n```\n\nNow, let\'s save these implementations into the respective files.', 'input_size': 4358, 'output_size': 3262, 'has_tool_calls': True, 'stage': 'after'} 
