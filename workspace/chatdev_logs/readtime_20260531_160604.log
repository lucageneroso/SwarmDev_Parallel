_count)\r\n        return f"Estimated reading time: {reading_time} minutes"\r\n    \r\n    def calculate_reading_time_with_details(self, text: str) -> str:\r\n        """\r\n        Calculate the estimated reading time with details for a given text.\r\n        \r\n        Args:\r\n            text (str): The input text to analyze.\r\n        \r\n        Returns:\r\n            str: Estimated reading time in minutes along with the word count.\r\n        """\r\n        word_count = TextAnalyzer.count_words(text)\r\n        reading_time = TextAnalyzer.estimate_reading_time(word_count)\r\n        return f"Estimated reading time: {reading_time} minutes for {word_count} words"\r\n    \r\n    def calculate_reading_time_for_multiple_texts(self, texts: list) -> list:\r\n        """\r\n        Calculate the estimated reading time for multiple texts.\r\n        \r\n        Args:\r\n            texts (list): A list of texts to analyze.\r\n        \r\n        Returns:\r\n            list: A list of estimated reading times for each text.\r\n        """\r\n        results = []\r\n        for text in texts:\r\n            word_count = TextAnalyzer.count_words(text)\r\n            reading_time = TextAnalyzer.estimate_reading_time(word_count)\r\n            results.append(f"Estimated reading time for text: {reading_time} minutes")\r\n        return results', 'newline': '\r\n'}, 'stage': 'before'} Duration: 0.0059964656829833984
